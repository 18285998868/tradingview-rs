# 复制为 .env 后按需修改；.env 已被 git 忽略。
# 生成令牌：openssl rand -hex 32
TV_AUTH_TOKEN=change-me-to-a-long-random-token

# 宿主机端口与行情数据目录。
TV_PORT=3001
TV_DATA_HOST_DIR=/data/data

# data-reader 仓库位置（相对本仓库）与状态卷名。
TV_DATA_READER_DIR=../data-reader
# TV_STATE_VOLUME=tradingview-rs-state

# 构建需要走宿主机回环代理时改为 host。
# TV_BUILD_NETWORK=host
